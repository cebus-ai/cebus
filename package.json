{
  "name": "cebus",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-model group chat — communicate with multiple AI models simultaneously",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!@cebus/cli",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "security:gitleaks": "gitleaks detect --source . --verbose --config .gitleaks.toml",
    "security:semgrep": "semgrep --config .semgrep.yml --config p/typescript --config p/owasp-top-ten .",
    "security:audit": "npm audit --audit-level=high",
    "install:vscode": "npm run build -w apps/vscode && npm run install:extension -w apps/vscode",
    "postinstall": "node scripts/patch-vscode-jsonrpc.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml}": [
      "prettier --write"
    ],
    "!(package-lock).json": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "chat",
    "cli",
    "multi-model",
    "openai",
    "anthropic",
    "copilot",
    "gemini",
    "ollama",
    "llm",
    "langgraph",
    "group-chat"
  ],
  "author": "Cebus Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/cebus-ai/cebus.git"
  },
  "homepage": "https://github.com/cebus-ai/cebus",
  "bugs": {
    "url": "https://github.com/cebus-ai/cebus/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3",
    "lightningcss": "^1.31.1"
  },
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {}
}
