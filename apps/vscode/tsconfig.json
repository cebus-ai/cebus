{
  "extends": "@cebus/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "types": ["vscode", "node"],
    "paths": {
      "@vscode/*": ["./*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "webview-app"]
}
